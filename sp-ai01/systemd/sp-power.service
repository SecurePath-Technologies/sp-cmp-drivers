[Unit]
Description=sp-power: CPU caps, CMP power/clocks/boot guard, GPU fans, thermal limits (one service; /etc/sp-power.conf)
After=nvidia-persistenced.service sp-cmp-gen2.service
Wants=nvidia-persistenced.service
# The units it replaces; Conflicts= stops them if anything starts one again.
Conflicts=cpu-powercap.service quiet-power.service quiet-fans.service sp-cmp-powercap.service sp-cmp-thermal-watchdog.service sp-cmp-safe-boot.service sp-cmp-perf-profile.service sp-cmp-perf-stable.service sp-cmp-clock-governor.service 170tune-persist.service 170tune-bootcheck.service sp-cmp-perf-profile.timer sp-cmp-perf-stable.timer

[Service]
Type=simple
ExecStart=/usr/bin/python3 -I /usr/local/sbin/sp-power run
ExecReload=/bin/kill -HUP $MAINPID
Restart=always
RestartSec=3
SyslogIdentifier=sp-power
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
