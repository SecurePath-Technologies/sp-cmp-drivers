[Unit]
Description=sp-power: CPU caps, CMP power/clocks/boot guard, GPU fans, thermal limits (one service; /etc/sp-power.conf)
After=nvidia-persistenced.service sp-cmp-gen2.service
Wants=nvidia-persistenced.service
# If other units on your host also set power limits, clocks or fans, list them here so they cannot fight it:
# Conflicts=<unit> ...

[Service]
Type=simple
ExecStart=/usr/bin/python3 -I /usr/local/sbin/sp-power run
ExecReload=/bin/kill -HUP $MAINPID
Restart=always
RestartSec=3
SyslogIdentifier=sp-power
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
